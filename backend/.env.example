PORT=3300
MONGODB_URI=mongodb://127.0.0.1:27017/plumber-finder
# A long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.yourcompany.web
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Email for one-time codes (signup confirmation, password reset). Gmail needs an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Plumber Finder <yourname@gmail.com>"
