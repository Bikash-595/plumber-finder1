PORT=3300

# Local: mongodb://127.0.0.1:27017/plumber-finder  (or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/plumber-finder

# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web application client ID (same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=123456789012-example.apps.googleusercontent.com

# Comma-separated allowed frontend origins (no trailing path)
FRONTEND_URL=http://localhost:3000

# Admin panel origin(s) (separate app in ../admin), comma-separated.
ADMIN_URL=http://localhost:3001

# Sign in with Apple (optional): your Services ID (and iOS bundle ID if apps share this API), comma-separated.
# Apple sign-in answers 503 until this is set.
# APPLE_CLIENT_ID=com.plumberfinder.web




ADMIN_URL=http://localhost:3001
ADMIN_EMAIL=admin@plumberfinder.com
ADMIN_NAME=Plumber Finder Admin
ADMIN_PASSWORD=QVSTfL6LheVmNsfGc28DsdA2